# ==============================================================================
# CivicSignal Environment Configuration Template
# Copy this file to .env and fill in your values. Never commit .env to source control!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="CivicSignal"
API_V1_STR="/api"

# Security & Authentication
JWT_SECRET_KEY="change-me-to-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database (Read-Write primary connection)
# In Docker: postgresql://civicuser:civicpassword@db:5432/civicsignal
# Local Postgres: postgresql://civicuser:civicpassword@localhost:5432/civicsignal
# Local SQLite fallback for fast dev: sqlite:///./civicsignal.db
DATABASE_URL="postgresql://civicuser:civicpassword@localhost:5432/civicsignal"

# PostgreSQL Database (Read-Only restricted connection for NL-to-SQL)
# Granted SELECT only on an allow-list of tables (never on users table)
DATABASE_READONLY_URL="postgresql://civic_readonly:readonlypassword@localhost:5432/civicsignal"

# Groq API Configuration (LangChain integration)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL_NAME="llama-3.3-70b-versatile"

# Machine Learning & Vector Search
EMBEDDING_MODEL_NAME="paraphrase-multilingual-MiniLM-L12-v2"
FAISS_INDEX_PATH="ml/artifacts/complaint_faiss.index"
CLASSIFIER_MODEL_PATH="ml/artifacts/classifier_model.pkl"

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
